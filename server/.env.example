# Csbox Cloud Academy - Backend Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# Database
# Example: https://mgwxfeutwzbhrokdohih.supabase.co
DATABASE_URL=postgresql://csbox_user:csbox_password@localhost:5432/csbox_db

# Supabase Service Role Key (Secret - for backend admin operations only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Redis (optional, for rate limiting and sessions)
REDIS_URL=redis://localhost:6379

# File Storage
STORAGE_PROVIDER=local
STORAGE_PATH=./uploads
MAX_FILE_SIZE_MB=50

# Email (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM=noreply@csbox.dev

# Feature Flags
ENABLE_MFA=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_AUDIT_LOGGING=true
